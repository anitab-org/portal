{% extends "dashboard/base.html" %}
{% block title %}Edit Profile{% endblock %}
{% block body_block %}
<div class="hero-unit">
    <h1>Edit Community Profile</h1>
    <br/>
 <div class="container">
{% if community %}
<form id="useredit_form" method="post" action="/superadmin_dashboard/edit_communityprofile/{{community_name}}"
enctype="multipart/form-data">
{% csrf_token %}
{{ communityform.as_p }}
<input type="submit" name="submit" value="Save" />
</form>
{% else %}
The specified category {{ community_name }} does not exist!
{% endif %}
{% endblock %}
